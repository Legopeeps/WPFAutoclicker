<Window
    x:Class="WPFAutoclicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFAutoclicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Autoclicker by Legopeeps"
    Width="300"
    Height="400"
    Background="AntiqueWhite"
    ResizeMode="NoResize"
    mc:Ignorable="d">

    <StackPanel Margin="50,0,50,0">
        <Button
            x:Name="btnStartAuto"
            Grid.Column="0"
            Height="50"
            MaxWidth="200"
            MaxHeight="50"
            Margin="0,5,0,0"
            Background="YellowGreen"
            Click="ButtonStartAuto_Click">
            StartAutoclicker
        </Button>
        <Button
            x:Name="btnStopAuto"
            Grid.Column="2"
            Height="50"
            MaxWidth="200"
            MaxHeight="50"
            Margin="0,5,0,0"
            Background="IndianRed"
            Click="ButtonStopAuto_Click"
            IsEnabled="False">
            StopAutoclicker
        </Button>
        <Button
            x:Name="btnSelectWindow"
            Grid.Column="2"
            Height="25"
            MaxWidth="100"
            MaxHeight="25"
            Margin="0,5,0,0"
            Background="GhostWhite"
            MouseDown="btnSelectWindow_MouseDown">
            Select Window
        </Button>
        <TextBlock
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Text="Delay (ms):"
            TextDecorations="Underline" />
        <TextBox
            x:Name="txtDelay"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            LostFocus="txtDelay_LostFocus"
            MaxLength="10"
            Text="1000"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="txtEquivalentTime"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Text="Clicks per second = x"
            TextWrapping="Wrap" />
    </StackPanel>
</Window>
