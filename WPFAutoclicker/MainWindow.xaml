<Window
    x:Class="WPFAutoclicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WPFAutoclicker"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Autoclicker"
    Width="300"
    Height="400"
    Background="AntiqueWhite"
    mc:Ignorable="d">

    <StackPanel
        Grid.Row="1"
        Grid.Column="1"
        Margin="50,0,50,0">
        <Button
            x:Name="btnStartAuto"
            Grid.Column="0"
            Height="50"
            MaxWidth="200"
            MaxHeight="50"
            Margin="0,5,0,0"
            MouseDown="ButtonStartAuto_Click">
            StartAutoclicker
        </Button>
        <Button
            x:Name="btnStopAuto"
            Grid.Column="2"
            Height="50"
            MaxWidth="200"
            MaxHeight="50"
            Margin="0,5,0,0"
            MouseDown="ButtonStopAuto_Click">
            StopAutoclicker
        </Button>
        <TextBlock
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Text="Delay (ms):" />
        <TextBox
            x:Name="txtDelay"
            Margin="0,10,0,0"
            HorizontalAlignment="Center"
            Text="1000" />
    </StackPanel>
</Window>
