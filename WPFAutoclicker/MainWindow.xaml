<Window x:Class="WPFAutoclicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFAutoclicker"
        mc:Ignorable="d"
        Title="Autoclicker" Height="400" Width="600" Background="AntiqueWhite">
    <Grid Margin = "10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Button x:Name="btnStartAuto" Grid.Column="1" Margin="0,5,0,0" Height="50" Width="200" MaxHeight="50" MaxWidth="200" Click="ButtonStartAuto_Click">StartAutoclicker</Button>
        

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="50,0,50,0">
        <Label HorizontalAlignment="Center">Settings</Label>
        
        <Label HorizontalAlignment="Left">Delay (ms):</Label>  
            
        </StackPanel>

    </Grid>
</Window>
